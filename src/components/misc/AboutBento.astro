---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { aboutConfig } from "../../config/about";
import { profileConfig } from "../../config";
import ImageWrapper from "./ImageWrapper.astro";

const config = aboutConfig;
const amapKey = import.meta.env.PUBLIC_AMAP_KEY || "";
const amapSecurityJsCode = import.meta.env.PUBLIC_AMAP_SECURITY_JS_CODE || "";
const amapServiceHost = import.meta.env.PUBLIC_AMAP_SERVICE_HOST || "";
const skillRows = [
	config.creativeSkills.filter((_, index) => index % 2 === 0),
	config.creativeSkills.filter((_, index) => index % 2 === 1),
];
const publishedPosts = await getCollection("posts", ({ data }) => !data.draft);
const firstPublishedAt = Math.min(...publishedPosts.map(({ data }) => data.published.getTime()));
const recordDays = Number.isFinite(firstPublishedAt)
	? Math.max(1, Math.floor((Date.now() - firstPublishedAt) / 86_400_000) + 1)
	: 0;
const siteStats = [
	{ label: "总访问量", value: "—", id: "busuanzi_site_pv" },
	{ label: "总访客数", value: "—", id: "busuanzi_site_uv" },
	{ label: "文章总数", value: String(publishedPosts.length) },
	{ label: "记录天数", value: String(recordDays) },
];
---

<section class="about-bento" aria-label="个人信息卡片">
	<div class="about-card hello-card">
		<div class="hello-copy">
			<p class="eyebrow">{config.intro.eyebrow}</p>
			<h1>我叫 <span>{config.intro.name}</span></h1>
			<p class="intro-description">{config.intro.description}</p>
			<div class="role-list" aria-label="个人标签">
				{config.intro.roles.map((role) => <span>{role}</span>)}
			</div>
		</div>
		<div class="avatar-wrap" aria-hidden="true">
			<div class="avatar-glow"></div>
			<ImageWrapper
				src={profileConfig.avatar || ""}
				alt={`${config.intro.name}的头像`}
				class="avatar-image"
			/>
		</div>
	</div>

	<div class="about-card interests-card">
		<div class="skill-showcase-copy">
			<div class="card-label">技能</div>
			<h2>常用工具</h2>
			<p>把熟悉的技术化作可访问、可分享的作品。</p>
		</div>
		<div class="skill-showcase-stage">
			<div class="skill-icon-rail" aria-hidden="true">
				<div class="creative-skill-tracks">
					{skillRows.map((row, rowIndex) => (
						<div class:list={["creative-skill-row", `creative-skill-row-${rowIndex + 1}`]}>
							{[row, row].map((group) => (
								<div class="creative-skill-group">
									{group.map((skill) => (
										<div class="creative-skill-icon" style={`--skill-bg:${skill.background};--skill-fg:${skill.foreground}`}>
											<Icon name={skill.icon} />
										</div>
									))}
								</div>
							))}
						</div>
					))}
				</div>
			</div>
			<div class="skill-summary-list" aria-label="技能与工具列表">
				<div class="skill-summary-flow">
					{config.creativeSkills.map((skill) => (
						<div class="skill-summary-item">
							<span class="skill-summary-icon" style={`--skill-bg:${skill.background};--skill-fg:${skill.foreground}`}>
								<Icon name={skill.icon} />
							</span>
							<span>{skill.name}</span>
						</div>
					))}
					<span class="skill-summary-more" aria-hidden="true" hidden>…</span>
				</div>
			</div>
		</div>
	</div>

	<div class="about-card status-card">
		<div class="card-label">此刻的状态</div>
		<div class="status-list">
			{config.status.map((item) => (
				<div class="status-item">
					<div class="status-icon"><Icon name={item.icon} /></div>
					<div><span>{item.label}</span><strong>{item.value}</strong></div>
				</div>
			))}
		</div>
		<div class="status-orbit" aria-hidden="true"><span></span></div>
	</div>

	<a
		href="https://www.16personalities.com/ch/档案/ab26a28092110"
		target="_blank"
		rel="noopener noreferrer"
		class="about-card mbti-card"
		aria-label="查看我的 16Personalities MBTI 测试结果"
	>
		<div class="mbti-copy">
			<div class="card-label">性格 · MBTI</div>
			<div class="mbti-type">{config.mbti.type}</div>
			<p>{config.mbti.description}</p>
		</div>
		<div class="mbti-art" aria-hidden="true">
			<img
				src="/images/about/intp-logician-s3-male.svg"
				alt=""
				class="mbti-illustration"
				loading="lazy"
			/>
		</div>
	</a>

	<div class="about-card skills-card">
		<div class="card-label">日常环境</div>
		<h2>常用工具</h2>
		<div class="skill-list">
			{config.skills.map((skill) => (
				<div class="skill-item">
					<Icon name={skill.icon} />
					<span>{skill.name}</span>
				</div>
			))}
		</div>
	</div>

	<div class="about-card site-card">
		<div class="site-card-content">
			<div class="card-label">统计</div>
			<h2>站点数据</h2>
			<div class="fact-list" data-busuanzi-stats>
				{siteStats.map((fact) => (
					<div class="fact-item">
						<span>{fact.label}</span>
						<strong id={fact.id}>{fact.value}</strong>
					</div>
				))}
			</div>
		</div>
	</div>

	<div class="about-card map-card">
		<a
			href="https://uri.amap.com/marker?position=116.682,23.3535&name=汕头&src=xgb819.github.io&coordinate=wgs84&callnative=0"
			target="_blank"
			rel="noopener noreferrer"
			class="map-link"
			aria-label="在高德地图查看广东省汕头市"
		>
			<div
				class="amap-stage"
				data-amap-key={amapKey}
				data-amap-security-code={amapSecurityJsCode}
				data-amap-service-host={amapServiceHost}
			>
				<div class="amap-fallback" aria-hidden="true"></div>
				<div class="amap-canvas" aria-hidden="true"></div>
			</div>
			<div class="map-copy">
				<span>我现在住在</span>
				<strong>{config.location.label}，广东</strong>
			</div>
		</a>
	</div>

	<div class="about-card contact-card">
		<div>
			<div class="card-label">保持联系</div>
			<h2>在这些地方找到我</h2>
			<p>欢迎交流技术、分享好玩的软件，或者只是来打个招呼。</p>
		</div>
		<div class="contact-list">
			{profileConfig.links.map((link) => (
				<a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined} aria-label={link.name}>
					<Icon name={link.icon} />
					<span>{link.name}</span>
				</a>
			))}
		</div>
	</div>
</section>

<script>
	const maxSkillSummaryRows = 4;
	type AMapApi = {
		Map: new (container: HTMLElement, options: Record<string, unknown>) => unknown;
		Marker: new (options: Record<string, unknown>) => { setMap: (map: unknown) => void };
	};
	type AMapWindow = Window & typeof globalThis & {
		AMap?: AMapApi;
		_AMapSecurityConfig?: { securityJsCode?: string; serviceHost?: string };
	};

	let amapLoadPromise: Promise<AMapApi> | undefined;

	function loadAMap(key: string, securityJsCode: string, serviceHost: string) {
		const amapWindow = window as AMapWindow;
		if (amapWindow.AMap) return Promise.resolve(amapWindow.AMap);
		if (amapLoadPromise) return amapLoadPromise;

		amapWindow._AMapSecurityConfig = serviceHost ? { serviceHost } : { securityJsCode };
		amapLoadPromise = new Promise((resolve, reject) => {
			const script = document.createElement("script");
			script.src = `https://webapi.amap.com/maps?v=2.0&key=${encodeURIComponent(key)}`;
			script.async = true;
			script.onload = () => amapWindow.AMap ? resolve(amapWindow.AMap) : reject(new Error("高德地图初始化失败"));
			script.onerror = () => reject(new Error("高德地图资源加载失败"));
			document.head.append(script);
		});
		return amapLoadPromise;
	}

	function initAboutMaps() {
		document.querySelectorAll<HTMLElement>(".amap-stage").forEach((stage) => {
			if (stage.dataset.initialized) return;
			stage.dataset.initialized = "true";

			const key = stage.dataset.amapKey || "";
			if (!key) {
				stage.dataset.state = "missing-key";
				return;
			}

			const securityJsCode = stage.dataset.amapSecurityCode || "";
			const serviceHost = stage.dataset.amapServiceHost || "";
			const canvas = stage.querySelector<HTMLElement>(".amap-canvas");
			if (!canvas) return;

			loadAMap(key, securityJsCode, serviceHost).then((AMap) => {
				const map = new AMap.Map(canvas, {
					center: [116.682, 23.3535],
					zoom: 9,
					viewMode: "2D",
					mapStyle: "amap://styles/normal",
					showLabel: true,
					dragEnable: false,
					zoomEnable: false,
					keyboardEnable: false,
					doubleClickZoom: false,
				});
				new AMap.Marker({ position: [116.682, 23.3535], anchor: "bottom-center" }).setMap(map);
				stage.closest<HTMLElement>(".map-card")?.classList.add("map-ready");
			}).catch(() => {
				stage.dataset.state = "error";
			});
		});
	}

	function fitSkillSummary(list: HTMLElement) {
		const flow = list.querySelector<HTMLElement>(".skill-summary-flow");
		const more = list.querySelector<HTMLElement>(".skill-summary-more");
		if (!flow || !more) return;

		const items = Array.from(flow.querySelectorAll<HTMLElement>(".skill-summary-item"));
		items.forEach((item) => { item.hidden = false; });
		more.hidden = true;

		const rowTops = [...new Set(items.map((item) => Math.round(item.offsetTop)))];
		if (rowTops.length <= maxSkillSummaryRows) return;

		const lastVisibleRowTop = rowTops[maxSkillSummaryRows - 1];
		items.forEach((item) => {
			item.hidden = Math.round(item.offsetTop) > lastVisibleRowTop;
		});
		more.hidden = false;

		let visibleItems = items.filter((item) => !item.hidden);
		let visibleRows = [...new Set([...visibleItems, more].map((item) => Math.round(item.offsetTop)))];
		while (visibleRows.length > maxSkillSummaryRows && visibleItems.length > 0) {
			visibleItems.at(-1)!.hidden = true;
			visibleItems = items.filter((item) => !item.hidden);
			visibleRows = [...new Set([...visibleItems, more].map((item) => Math.round(item.offsetTop)))];
		}

		const hiddenCount = items.filter((item) => item.hidden).length;
		more.setAttribute("aria-label", `另有 ${hiddenCount} 项工具`);
		more.removeAttribute("aria-hidden");
	}

	function initSkillSummaries() {
		document.querySelectorAll<HTMLElement>(".skill-summary-list").forEach((list) => {
			fitSkillSummary(list);
			if (list.dataset.resizeObserved) return;
			list.dataset.resizeObserved = "true";
			new ResizeObserver(() => fitSkillSummary(list)).observe(list);
		});
	}

	function initBusuanziStats() {
		const stats = document.querySelector<HTMLElement>("[data-busuanzi-stats]");
		if (!stats || stats.dataset.initialized) return;
		stats.dataset.initialized = "true";

		if (["localhost", "127.0.0.1", "::1"].includes(window.location.hostname)) {
			stats.dataset.state = "local-preview";
			return;
		}

		document.getElementById("busuanzi-about-script")?.remove();
		const script = document.createElement("script");
		script.id = "busuanzi-about-script";
		script.src = "https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js";
		script.defer = true;
		script.onerror = () => { stats.dataset.state = "error"; };
		document.head.append(script);
	}

	requestAnimationFrame(initSkillSummaries);
	requestAnimationFrame(initAboutMaps);
	requestAnimationFrame(initBusuanziStats);
	document.addEventListener("astro:page-load", initSkillSummaries);
	document.addEventListener("astro:page-load", initAboutMaps);
	document.addEventListener("astro:page-load", initBusuanziStats);
</script>

<style>
	.about-bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1rem;
	}

	.about-card {
		--about-item-bg: color-mix(in oklab, var(--btn-regular-bg) 55%, var(--btn-regular-bg-hover) 45%);
		position: relative;
		overflow: hidden;
		border-radius: calc(var(--radius-large) - 0.125rem);
		background-color: var(--btn-plain-bg-hover);
		color: rgb(38 38 38 / 0.9);
		transition: all 200ms;
	}

	:global(.dark) .about-card { color: rgb(255 255 255 / 0.9); }
	.about-card:hover { --about-item-bg: var(--btn-regular-bg); background-color: var(--btn-card-bg-hover); }
	.about-card:active { background-color: var(--btn-card-bg-active); }
	.interests-card:active { background-color: var(--btn-plain-bg-hover); }
	:global(.dark) .about-card:hover {
		--about-item-bg: color-mix(in oklab, var(--btn-regular-bg) 55%, var(--btn-regular-bg-hover) 45%);
		background-color: var(--btn-plain-bg-hover);
	}
	:global(.dark) .about-card:active { background-color: var(--btn-card-bg-active); }
	:global(.dark) .interests-card:active { background-color: var(--btn-plain-bg-hover); }
	.card-label { margin-bottom: 0.45rem; color: var(--primary); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

	.hello-card {
		grid-column: span 12;
		min-height: 18rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 2rem;
	}
	.hello-copy { z-index: 2; width: calc(100% - 16rem); max-width: 34rem; }
	.eyebrow { margin: 0 0 0.75rem; color: var(--primary); font-weight: 700; }
	.hello-card h1 { margin: 0; font-size: clamp(2rem, 4vw, 2.7rem); font-weight: 700; line-height: 1.12; }
	.hello-card h1 span { color: var(--primary); }
	.intro-description { max-width: 31rem; margin: 1rem 0 1.25rem; color: rgb(64 64 64 / 0.72); line-height: 1.8; }
	:global(.dark) .intro-description { color: rgb(255 255 255 / 0.65); }
	.role-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.role-list span { border-radius: 999px; background: var(--about-item-bg); padding: 0.4rem 0.75rem; color: var(--btn-content); font-size: 0.8rem; font-weight: 700; transition: background 200ms, color 200ms; }
	.role-list span:hover { background: var(--btn-regular-bg-hover); color: var(--primary); }
	.role-list span:active { background: var(--btn-regular-bg-active); }
	.avatar-wrap { position: absolute; top: 2rem; right: 2rem; width: auto; height: calc(100% - 4rem); aspect-ratio: 1; display: block; overflow: hidden; border-radius: 0.75rem; }
	.avatar-glow { position: absolute; inset: 10%; border-radius: 50%; background: var(--primary); filter: blur(2.5rem); opacity: 0.18; }
	.avatar-wrap :global(.avatar-image) { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; overflow: hidden; border-radius: 0.75rem; box-shadow: 0 0.8rem 2.5rem rgb(0 0 0 / 0.12); }
	.avatar-wrap :global(.avatar-image img) { width: 100%; height: 100%; object-fit: cover; }

	.mbti-card { grid-column: span 7; min-height: 18rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 1.5rem; }
	.mbti-copy { position: relative; z-index: 2; min-width: 0; padding-right: 0.75rem; }
	.mbti-art { min-width: 0; display: flex; align-items: flex-end; justify-content: flex-end; }
	.mbti-type { margin: 0.4rem 0 0.25rem; color: rgb(38 38 38 / 0.9); font-size: 2.6rem; font-weight: 900; letter-spacing: -0.04em; transition: color 200ms; }
	:global(.dark) .mbti-type { color: rgb(255 255 255 / 0.9); }
	.mbti-card:hover .mbti-type { color: var(--primary); }
	.interests-card h2, .skills-card h2, .site-card h2 { margin: 0; font-size: 1.35rem; font-weight: 700; }
	.mbti-card p { width: 100%; max-width: none; margin: 0.7rem 0 0; color: rgb(64 64 64 / 0.65); font-size: 0.88rem; line-height: 1.65; }
	:global(.dark) .mbti-card p { color: rgb(255 255 255 / 0.58); }
	.mbti-illustration { width: 100%; max-width: 11rem; height: auto; aspect-ratio: 1; object-fit: contain; opacity: 0.92; pointer-events: none; }

	.map-card { grid-column: span 7; min-height: 17rem; padding: 0; }
	.map-link { position: absolute; inset: 0; display: grid; grid-template-rows: minmax(0, 1fr) 4rem; overflow: hidden; border-radius: inherit; color: inherit; }
	.amap-stage { position: relative; min-width: 0; min-height: 0; overflow: hidden; transition: filter 200ms, opacity 200ms; }
	.amap-fallback, .amap-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
	.amap-fallback { background: #dcefff; transition: opacity 250ms; }
	.amap-canvas { opacity: 0; pointer-events: none; transition: opacity 250ms; }
	:global(.map-card .amap-logo) { bottom: 0.45rem !important; left: 0.5rem !important; }
	:global(.map-card .amap-copyright) { right: 0.5rem !important; bottom: 0.45rem !important; left: auto !important; }
	:global(.dark .map-card .amap-copyright) { color: rgb(24 24 27 / 0.82) !important; }
	.map-card.map-ready .amap-fallback { opacity: 0; }
	.map-card.map-ready .amap-canvas { opacity: 1; }
	:global(.dark) .amap-stage { filter: brightness(0.7) saturate(0.82) contrast(1.06); opacity: 0.9; }
	:global(.dark) .amap-fallback { background: #26384d; color: #75b8ff; }
	.map-copy { position: relative; z-index: 2; display: flex; align-items: center; gap: 0.35rem; min-width: 0; padding: 0.75rem 1.5rem; border-radius: 0 0 calc(var(--radius-large) - 0.125rem) calc(var(--radius-large) - 0.125rem); background: color-mix(in oklab, var(--btn-plain-bg-hover) 88%, transparent); font-size: 1rem; transition: background-color 200ms; backdrop-filter: saturate(140%) blur(0.65rem); }
	.map-card:hover .map-copy { background-color: var(--btn-card-bg-hover); }
	.map-card:active .map-copy { background-color: var(--btn-card-bg-active); }
	:global(.dark) .map-card:hover .map-copy { background-color: var(--btn-plain-bg-hover); }
	:global(.dark) .map-card:active .map-copy { background-color: var(--btn-card-bg-active); }
	.map-copy span { flex: none; color: rgb(64 64 64 / 0.68); }
	.map-copy strong { min-width: 0; overflow: hidden; color: rgb(38 38 38 / 0.92); font-size: 1.08rem; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; transition: color 200ms; }
	.map-card:hover .map-copy strong { color: var(--primary); }
	:global(.dark) .map-copy span { color: rgb(255 255 255 / 0.62); }
	:global(.dark) .map-copy strong { color: rgb(255 255 255 / 0.92); }
	:global(.dark) .map-card:hover .map-copy strong { color: var(--primary); }

	.interests-card { grid-column: span 7; min-height: 23rem; display: flex; flex-direction: column; padding: 1.5rem 0; }
	.skill-showcase-copy { padding: 0 1.5rem; }
	.skill-showcase-copy p { max-width: 25rem; margin: 0.65rem 0 1.35rem; color: rgb(64 64 64 / 0.58); font-size: 0.82rem; line-height: 1.65; }
	:global(.dark) .skill-showcase-copy p { color: rgb(255 255 255 / 0.52); }
	.skill-showcase-stage { position: relative; min-height: 12.25rem; overflow: hidden; margin-top: auto; margin-bottom: 0.25rem; }
	.skill-icon-rail, .skill-summary-list { position: absolute; inset: 0; transition: opacity 240ms; }
	.skill-icon-rail { display: flex; align-items: center; opacity: 1; }
	.creative-skill-tracks { display: grid; gap: 0.75rem; width: 100%; }
	.creative-skill-row { width: max-content; display: flex; align-items: center; gap: 0.75rem; animation: skill-scroll 30s linear infinite; backface-visibility: hidden; will-change: transform; }
	.creative-skill-row-2 { animation-name: skill-scroll-offset; animation-duration: 26.25s; }
	.creative-skill-group { display: flex; align-items: center; gap: 0.75rem; flex: none; }
	.creative-skill-icon { width: 5.5rem; height: 5.5rem; display: grid; place-items: center; border-radius: 1.2rem; background: var(--skill-bg); color: var(--skill-fg); }
	.creative-skill-icon :global(svg) { font-size: 2.65rem; }
	.skill-summary-list { display: flex; align-items: center; padding: 0 1.5rem; overflow: hidden; opacity: 0; pointer-events: none; }
	.skill-summary-flow { width: 100%; display: flex; align-content: flex-start; flex-wrap: wrap; gap: 0.5rem 0.55rem; }
	.skill-summary-item { width: auto; height: 2.55rem; display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.7rem 0.35rem 0.35rem; border-radius: 999px; background: var(--btn-regular-bg); font-family: inherit; font-size: 0.72rem; font-weight: 700; transition: background 200ms, color 200ms; }
	.skill-summary-item[hidden], .skill-summary-more[hidden] { display: none; }
	.skill-summary-item:hover { background: var(--btn-regular-bg-hover); color: var(--primary); }
	.skill-summary-item:active { background: var(--btn-regular-bg-active); }
	.skill-summary-item > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.skill-summary-icon { width: 1.85rem; height: 1.85rem; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--skill-bg); color: var(--skill-fg); }
	.skill-summary-icon :global(svg) { font-size: 1rem; }
	.skill-summary-more { height: 2.55rem; display: flex; align-items: center; padding: 0 0.2rem; background: transparent; color: var(--btn-content); font-family: inherit; font-size: 1.2rem; font-weight: 800; letter-spacing: 0.08em; }
	@keyframes skill-scroll {
		from { transform: translate3d(-5.5rem, 0, 0); }
		to { transform: translate3d(calc(-50% - 0.375rem - 5.5rem), 0, 0); }
	}
	@keyframes skill-scroll-offset {
		from { transform: translate3d(-2.375rem, 0, 0); }
		to { transform: translate3d(calc(-50% - 0.375rem - 2.375rem), 0, 0); }
