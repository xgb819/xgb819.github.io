---
import { Icon } from "astro-icon/components";
import { aboutConfig } from "../../config/about";
import { profileConfig } from "../../config";
import ImageWrapper from "./ImageWrapper.astro";

const config = aboutConfig;
---

<section class="about-bento" aria-label="个人信息卡片">
	<div class="about-card hello-card">
		<div class="hello-copy">
			<p class="eyebrow">{config.intro.eyebrow}</p>
			<h1>我叫 <span>{config.intro.name}</span></h1>
			<p class="intro-description">{config.intro.description}</p>
			<div class="role-list" aria-label="个人标签">
				{config.intro.roles.map((role) => <span>{role}</span>)}
			</div>
		</div>
		<div class="avatar-wrap" aria-hidden="true">
			<div class="avatar-glow"></div>
			<ImageWrapper
				src={profileConfig.avatar || ""}
				alt={`${config.intro.name}的头像`}
				class="avatar-image"
			/>
		</div>
	</div>

	<a
		href="https://www.16personalities.com/ch/档案/ab26a28092110"
		target="_blank"
		rel="noopener noreferrer"
		class="about-card mbti-card"
		aria-label="查看我的 16Personalities MBTI 测试结果"
	>
		<div class="card-label">性格 · MBTI</div>
		<div class="mbti-type">{config.mbti.type}</div>
		<p>{config.mbti.description}</p>
		<img
			src="/images/about/intp-logician-s3-male.svg"
			alt="INTP 逻辑学家形象"
			class="mbti-illustration"
			loading="lazy"
		/>
	</a>

	<div class="about-card status-card">
		<div class="card-label">此刻的状态</div>
		<div class="status-list">
			{config.status.map((item) => (
				<div class="status-item">
					<div class="status-icon"><Icon name={item.icon} /></div>
					<div><span>{item.label}</span><strong>{item.value}</strong></div>
				</div>
			))}
		</div>
		<div class="status-orbit" aria-hidden="true"><span></span></div>
	</div>

	<div class="about-card interests-card">
		<div class="section-heading">
			<div>
				<div class="card-label">关注与偏好</div>
				<h2>我的爱好</h2>
			</div>
			<Icon name="material-symbols:interests-rounded" />
		</div>
		<div class="interest-grid">
			{config.interests.map((interest) => (
				<div class="interest-item" style={`--accent:${interest.accent}`}>
					<div class="interest-icon"><Icon name={interest.icon} /></div>
					<div>
						<h3>{interest.name}</h3>
						<p>{interest.description}</p>
					</div>
				</div>
			))}
		</div>
	</div>

	<div class="about-card skills-card">
		<div class="card-label">正在使用</div>
		<h2>技能与工具</h2>
		<div class="skill-list">
			{config.skills.map((skill) => (
				<div class="skill-item">
					<Icon name={skill.icon} />
					<span>{skill.name}</span>
				</div>
			))}
		</div>
	</div>

	<div class="about-card map-card">
		<div class="map-copy">
			<div class="card-label">我所在的地方</div>
			<h2><Icon name="material-symbols:location-on-rounded" />{config.location.label}</h2>
			<p>{config.location.note}</p>
		</div>
		<div class="map-visual" aria-hidden="true">
			<svg viewBox="0 0 760 310" role="img">
				<path d="M55 111 92 72l62-12 40 23 58-6 42 28-17 35-49 8-25 40-45 12-26-32-54-10-19-25Z" />
				<path d="m292 62 52-24 49 13 26-22 88 12 28 25 72 10 40 34-28 25-54-2-27 26-56-12-33 17-35-20-42 5-38-23 13-29Z" />
				<path d="m334 168 56-10 40 28-8 62-35 42-31-31-22-52Z" />
				<path d="m594 205 43-26 67 16 25 38-32 34-70-4-30-26Z" />
				<path d="m142 207 39-23 45 26 20 48-39 38-42-24-25-39Z" />
			</svg>
			<div
				class="map-marker"
				style={`left:${config.location.marker.x}%;top:${config.location.marker.y}%`}
			>
				<span></span>
			</div>
		</div>
	</div>

	<div class="about-card site-card">
		<div class="card-label">关于本站</div>
		<h2>小站档案</h2>
		<div class="fact-list">
			{config.siteFacts.map((fact) => (
				<div class="fact-item">
					<Icon name={fact.icon} />
					<div><span>{fact.label}</span><strong>{fact.value}</strong></div>
				</div>
			))}
		</div>
	</div>

	<div class="about-card contact-card">
		<div>
			<div class="card-label">保持联系</div>
			<h2>在这些地方找到我</h2>
			<p>欢迎交流技术、分享好玩的软件，或者只是来打个招呼。</p>
		</div>
		<div class="contact-list">
			{profileConfig.links.map((link) => (
				<a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined} aria-label={link.name}>
					<Icon name={link.icon} />
					<span>{link.name}</span>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.about-bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1rem;
	}

	.about-card {
		position: relative;
		overflow: hidden;
		border-radius: calc(var(--radius-large) - 0.125rem);
		background-color: var(--btn-plain-bg-hover);
		color: rgb(38 38 38 / 0.9);
		transition: all 200ms;
	}

	:global(.dark) .about-card { color: rgb(255 255 255 / 0.9); }
	.about-card:hover { background-color: var(--btn-card-bg-hover); }
	.about-card:active { background-color: var(--btn-card-bg-active); }
	.card-label { margin-bottom: 0.45rem; color: var(--primary); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

	.hello-card {
		grid-column: span 12;
		min-height: 18rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 2rem;
	}
	.hello-copy { z-index: 2; width: calc(100% - 16rem); max-width: 34rem; }
	.eyebrow { margin: 0 0 0.75rem; color: var(--primary); font-weight: 700; }
	.hello-card h1 { margin: 0; font-size: clamp(2rem, 4vw, 2.7rem); line-height: 1.12; }
	.hello-card h1 span { color: var(--primary); }
	.intro-description { max-width: 31rem; margin: 1rem 0 1.25rem; color: rgb(64 64 64 / 0.72); line-height: 1.8; }
	:global(.dark) .intro-description { color: rgb(255 255 255 / 0.65); }
	.role-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.role-list span { border-radius: 999px; background: var(--btn-regular-bg); padding: 0.4rem 0.75rem; color: var(--btn-content); font-size: 0.8rem; font-weight: 700; }
	.avatar-wrap { position: absolute; inset: 2rem 2rem 2rem auto; width: 14rem; display: block; overflow: hidden; border-radius: 0.75rem; }
	.avatar-glow { position: absolute; inset: 10%; border-radius: 50%; background: var(--primary); filter: blur(2.5rem); opacity: 0.18; }
	.avatar-image { position: relative; z-index: 1; width: 100%; height: 100%; overflow: hidden; border-radius: 0.75rem; box-shadow: 0 0.8rem 2.5rem rgb(0 0 0 / 0.12); }
	.avatar-image :global(img) { width: 100%; height: 100%; object-fit: cover; }

	.mbti-card { grid-column: span 7; min-height: 18rem; padding: 1.5rem; }
	.mbti-card > :not(.mbti-illustration) { position: relative; z-index: 2; }
	.mbti-type { margin: 0.4rem 0 0.25rem; color: rgb(38 38 38 / 0.9); font-size: 2.6rem; font-weight: 900; letter-spacing: -0.04em; transition: color 200ms; }
	:global(.dark) .mbti-type { color: rgb(255 255 255 / 0.9); }
	.mbti-card:hover .mbti-type { color: var(--primary); }
	.map-card h2, .interests-card h2, .skills-card h2 { margin: 0; font-size: 1.35rem; }
	.mbti-card p { max-width: 12rem; margin: 0.7rem 0 0; color: rgb(64 64 64 / 0.65); font-size: 0.88rem; line-height: 1.65; }
	:global(.dark) .mbti-card p { color: rgb(255 255 255 / 0.58); }
	.mbti-illustration { position: absolute; z-index: 1; right: 1.5rem; bottom: 1.5rem; width: 9.5rem; height: 9.5rem; object-fit: contain; opacity: 0.92; pointer-events: none; }

	.map-card { grid-column: span 7; min-height: 17rem; display: grid; align-items: stretch; }
	.map-copy { position: absolute; z-index: 2; left: 0; bottom: 0; max-width: 18rem; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.5rem; }
	.map-copy h2 { display: flex; align-items: center; gap: 0.4rem; font-size: 2rem; }
	.map-copy h2 :global(svg) { color: var(--primary); }
	.map-copy p { margin: 0.65rem 0 0; color: rgb(64 64 64 / 0.6); }
	:global(.dark) .map-copy p { color: rgb(255 255 255 / 0.55); }
	.map-visual { position: relative; min-height: 17rem; overflow: hidden; }
	.map-visual svg { position: absolute; inset: 7% 2% 2%; width: 96%; height: 90%; fill: color-mix(in oklab, var(--primary) 22%, transparent); stroke: color-mix(in oklab, var(--primary) 50%, transparent); stroke-width: 1.5; }
	.map-marker { position: absolute; z-index: 2; width: 1rem; height: 1rem; transform: translate(-50%, -50%); border: 3px solid var(--card-bg); border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 0 color-mix(in oklab, var(--primary) 45%, transparent); animation: map-pulse 2s infinite; }
	.map-marker span { position: absolute; inset: -0.45rem; border: 1px solid var(--primary); border-radius: 50%; opacity: 0.5; }
	@keyframes map-pulse { 70% { box-shadow: 0 0 0 1rem transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

	.interests-card { grid-column: span 7; padding: 1.5rem; }
	.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
	.section-heading > :global(svg) { color: var(--primary); font-size: 2.4rem; }
	.interest-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
	.interest-item { display: flex; align-items: center; gap: 0.75rem; min-width: 0; padding: 0.85rem; border-radius: 0.9rem; background: var(--btn-plain-bg-hover); transition: all 200ms; }
	.interest-item:hover { background: var(--btn-card-bg-hover); }
	.interest-item:active { background: var(--btn-card-bg-active); }
	.interest-icon { width: 2.8rem; height: 2.8rem; flex: none; display: grid; place-items: center; border-radius: 0.8rem; background: oklch(0.9 0.08 var(--accent)); color: oklch(0.5 0.16 var(--accent)); }
	:global(.dark) .interest-icon { background: oklch(0.32 0.06 var(--accent)); color: oklch(0.78 0.12 var(--accent)); }
	.interest-icon :global(svg) { font-size: 1.45rem; }
	.interest-item h3 { margin: 0; font-size: 0.95rem; transition: color 200ms; }
	.interest-item:hover h3 { color: var(--primary); }
	.interest-item p { overflow: hidden; margin: 0.2rem 0 0; color: rgb(64 64 64 / 0.55); font-size: 0.72rem; text-overflow: ellipsis; white-space: nowrap; }
	:global(.dark) .interest-item p { color: rgb(255 255 255 / 0.5); }

	.skills-card { grid-column: span 5; padding: 1.5rem; }
	.skill-list { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.2rem; }
	.skill-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.65rem 0.8rem; border-radius: 0.8rem; background: var(--btn-plain-bg-hover); font-size: 0.82rem; font-weight: 700; transition: all 200ms; }
	.skill-item:hover { background: var(--btn-card-bg-hover); color: var(--primary); }
	.skill-item:active { background: var(--btn-card-bg-active); }
	.skill-item :global(svg) { color: var(--primary); font-size: 1.2rem; }

	.status-card { grid-column: span 5; min-height: 18rem; display: flex; align-items: center; padding: 1.5rem; }
	.status-card > .card-label { position: absolute; top: 1.25rem; left: 1.5rem; }
	.status-list { display: grid; grid-template-columns: 1fr; gap: 0.8rem; width: calc(100% - 5rem); margin-top: 1.5rem; }
	.status-item { display: flex; align-items: center; gap: 0.75rem; }
	.status-icon { width: 2.7rem; height: 2.7rem; display: grid; place-items: center; border-radius: 50%; background: var(--btn-regular-bg); color: var(--primary); }
	.status-item span, .status-item strong { display: block; }
	.status-item span { margin-bottom: 0.12rem; color: rgb(64 64 64 / 0.5); font-size: 0.7rem; }
	:global(.dark) .status-item span { color: rgb(255 255 255 / 0.45); }
	.status-item strong { font-size: 0.92rem; }
	.status-orbit { position: absolute; right: 2rem; width: 5rem; height: 5rem; border: 1px dashed color-mix(in oklab, var(--primary) 50%, transparent); border-radius: 50%; animation: orbit-spin 8s linear infinite; }
	.status-orbit::before { content: ""; position: absolute; inset: 0.75rem; border: 1px solid color-mix(in oklab, var(--primary) 25%, transparent); border-radius: 50%; }
	.status-orbit span { position: absolute; left: 50%; top: -0.3rem; width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--primary); box-shadow: 0 0 1rem var(--primary); }
	@keyframes orbit-spin { to { transform: rotate(360deg); } }

	.site-card { grid-column: span 5; min-height: 17rem; padding: 1.5rem; }
	.site-card h2, .contact-card h2 { margin: 0; font-size: 1.35rem; }
	.fact-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem; margin-top: 1rem; }
	.fact-item { display: flex; align-items: center; gap: 0.55rem; min-width: 0; padding: 0.65rem; border-radius: 0.75rem; background: var(--btn-plain-bg-hover); transition: background 200ms; }
	.fact-item:hover { background: var(--btn-card-bg-hover); }
	.fact-item:active { background: var(--btn-card-bg-active); }
	.fact-item > :global(svg) { flex: none; color: var(--primary); font-size: 1.25rem; }
	.fact-item span, .fact-item strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.fact-item span { color: rgb(64 64 64 / 0.5); font-size: 0.62rem; }
	:global(.dark) .fact-item span { color: rgb(255 255 255 / 0.45); }
	.fact-item strong { font-size: 0.75rem; }

	.contact-card { grid-column: span 12; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 10rem; padding: 1.5rem; }
	.contact-card p { margin: 0.55rem 0 0; color: rgb(64 64 64 / 0.58); font-size: 0.85rem; }
	:global(.dark) .contact-card p { color: rgb(255 255 255 / 0.5); }
	.contact-list { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.65rem; }
	.contact-list a { display: flex; align-items: center; gap: 0.45rem; padding: 0.7rem 0.85rem; border-radius: 0.8rem; background: var(--btn-plain-bg-hover); font-size: 0.8rem; font-weight: 700; transition: all 200ms; }
	.contact-list a:hover { background: var(--btn-card-bg-hover); color: var(--primary); }
	.contact-list a:active { background: var(--btn-card-bg-active); }
	.contact-list :global(svg) { color: var(--primary); font-size: 1.2rem; }

	@media (max-width: 767px) {
		.about-bento { gap: 0.75rem; }
		.hello-card { min-height: 28rem; align-items: flex-start; padding: 1.5rem; }
		.hello-copy { width: 100%; max-width: none; padding-top: 11.5rem; }
		.avatar-wrap { inset: 1.5rem 1.5rem auto; width: auto; height: 10rem; border-radius: 0.75rem; }
		.avatar-image { width: 100%; height: 100%; border-radius: 0.75rem; box-shadow: 0 0.8rem 2.5rem rgb(0 0 0 / 0.12); }
		.hello-card h1 { font-size: 2.25rem; }
		.mbti-card, .map-card, .interests-card, .skills-card, .status-card, .site-card, .contact-card { grid-column: span 12; }
		.mbti-card { min-height: 13.5rem; }
		.map-card { grid-template-columns: 1fr; }
		.map-visual { min-height: 21rem; }
		.mbti-illustration { right: 1.5rem; bottom: 1.5rem; width: 7.5rem; height: 7.5rem; opacity: 0.86; }
		.interest-grid { grid-template-columns: 1fr; }
		.status-list { width: calc(100% - 4rem); gap: 0.7rem; }
		.status-orbit { right: -1.5rem; opacity: 0.65; }
		.fact-list { grid-template-columns: 1fr; }
		.contact-card { align-items: flex-start; flex-direction: column; }
		.contact-list { justify-content: flex-start; }
	}

	@media (prefers-reduced-motion: reduce) {
		.map-marker, .status-orbit { animation: none; }
		.about-card, .map-copy, .interest-item, .interest-item h3, .skill-item { transition: none; }
	}
</style>
