---
import { createHash } from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";

interface Props {
    name: string;
    description: string;
    logo: string;
    logoBackground?: string;
    url?: string;
}

const {
    name,
    description,
    logo,
    logoBackground = "#ffffff",
    url,
} = Astro.props;

let logoSrc = logo;
const publicLogoPath = logo.split("?", 1)[0];

if (publicLogoPath.startsWith("/")) {
    const logoFilePath = path.join(
        process.cwd(),
        "public",
        publicLogoPath.replace(/^\/+/, ""),
    );

    try {
        const version = createHash("sha256")
            .update(fs.readFileSync(logoFilePath))
            .digest("hex")
            .slice(0, 8);
        logoSrc = `${logo}${logo.includes("?") ? "&" : "?"}v=${version}`;
    } catch {
        // Keep the original URL when the logo is not a local public asset.
    }
}

const cardClass =
    "group flex min-w-0 items-center gap-4 rounded-lg bg-[var(--btn-plain-bg-hover)] p-4 transition-all duration-200 hover:bg-[var(--btn-card-bg-hover)] active:bg-[var(--btn-card-bg-active)]";
---

{url ? (
    <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class={`${cardClass} no-styling !no-underline !border-none hover:!no-underline hover:!border-none`}
    >
        <div
            class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-md"
            style={`background:${logoBackground};`}
        >
            <img src={logoSrc} alt="" width="48" height="48" class="no-lightbox h-full w-full !rounded-none object-contain" loading="lazy" />
        </div>
        <div class="min-w-0 flex-1">
            <div class="mb-1 truncate text-base font-bold text-90 transition-colors group-hover:text-[var(--primary)]">
                {name}
            </div>
            <div class="truncate text-sm text-neutral-600 dark:text-neutral-400">
                {description}
            </div>
        </div>
        <Icon
            name="material-symbols:open-in-new-rounded"
            class="h-4 w-4 shrink-0 text-neutral-400 transition-colors group-hover:text-[var(--primary)]"
        />
    </a>
) : (
    <div class={cardClass}>
        <div
            class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-md"
            style={`background:${logoBackground};`}
        >
            <img src={logoSrc} alt="" width="48" height="48" class="no-lightbox h-full w-full !rounded-none object-contain" loading="lazy" />
        </div>
        <div class="min-w-0 flex-1">
            <div class="mb-1 truncate text-base font-bold text-90">
                {name}
            </div>
            <div class="truncate text-sm text-neutral-600 dark:text-neutral-400">
                {description}
            </div>
        </div>
    </div>
)}
